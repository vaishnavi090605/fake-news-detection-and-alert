# ── Python Version (Render) ───────────────────────────────────────────────────
PYTHON_VERSION=3.11.9

# ── JWT Secret & Admin Registration Code ─────────────────────────────────────
FAKE_NEWS_SECRET_KEY=your_random_jwt_secret_key_change_this
FAKE_NEWS_ADMIN_CODE=your_chosen_admin_code

# ── Alert Email (receives every analysis alert & police dispatch) ─────────────
ALERT_EMAIL=your_alert_email@gmail.com

# ── Gmail SMTP (for local dev; often blocked on Render free tier) ─────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16chars

# ── Resend API (recommended for Render deployment — free 3000 emails/month) ───
RESEND_API_KEY=re_your_resend_api_key

# ── GNews API (live news search — free 100 req/day at gnews.io) ───────────────
GNEWS_API_KEY=your_gnews_api_key
